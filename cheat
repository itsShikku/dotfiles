#!/bin/bash

CHEAT_DIR="$HOME/dotfiles/cheatsheets"

if [ ! -d "$CHEAT_DIR" ]; then
  echo "❌ Ordner $CHEAT_DIR nicht gefunden!"
  exit 1
fi

# Wir nutzen bat oder batcat für die Farben, Fallback auf cat
if command -v batcat &>/dev/null; then
  VIEWER="batcat --style=plain --color=always --language=markdown"
elif command -v bat &>/dev/null; then
  VIEWER="bat --style=plain --color=always --language=markdown"
else
  VIEWER="cat"
fi

# ---- MODUS: EDITIEREN ----
if [ "$1" == "-e" ]; then
  SELECTION=$(ls "$CHEAT_DIR" | sed 's/\.md$//' | fzf --height 50% --layout=reverse --border \
    --header="📝 Welchen Spickzettel willst du in Neovim bearbeiten?" \
    --preview "$VIEWER $CHEAT_DIR/{}.md")

  if [ -n "$SELECTION" ]; then
    nvim "$CHEAT_DIR/${SELECTION}.md"
  else
    echo "Abgebrochen."
  fi
  exit 0
fi

# ---- MODUS: ANZEIGEN (STANDARD) ----
SELECTION=$(ls "$CHEAT_DIR" | sed 's/\.md$//' | fzf --height 50% --layout=reverse --border \
  --header="🧠 [Enter] Anzeigen | [Strg+C] Abbrechen" \
  --preview "$VIEWER $CHEAT_DIR/{}.md")

if [ -n "$SELECTION" ]; then
  echo -e "\n=== 📖 $SELECTION ===\n"
  $VIEWER "$CHEAT_DIR/${SELECTION}.md"
  echo ""
else
  echo "Abgebrochen."
fi

# ---- MODUS: BEFEHL AUSWÄHLEN & EINFÜGEN ----
if [ "$1" == "-p" ]; then # "-p" für "paste"
  # 1. Datei auswählen
  FILE=$(ls "$CHEAT_DIR" | fzf --height 40% --header="Wähle eine Kategorie")

  if [ -n "$FILE" ]; then
    # 2. Befehl aus der gewählten Datei auswählen
    # Geht davon aus, dass die Zeile mit "Befehl - Beschreibung" aufgebaut ist
    local CMD=$(echo "$SELECTION" | awk -F ' :: ' '{print $1}' | sed 's/.*://')
    if [ -n "$CMD" ]; then
      # Dies fügt den Befehl in die aktuelle Bash-Zeile ein
      READLINE_LINE="$CMD"
      READLINE_POINT=${#READLINE_LINE}
    fi
  fi
  exit 0
fi
